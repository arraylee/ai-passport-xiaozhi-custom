cardid_ledger.csv
*.ledger.csv
# 产线可能生成的分区镜像/密钥文件(含 Key)
*cardid*.bin
*.key

# ===== ESP-IDF 构建产物 =====
build/
build-*/
# 由 dependencies.lock + idf_component.yml 还原(idf.py reconfigure),不入库(224M)
managed_components/

# ===== sdkconfig:提交 sdkconfig 本体锁定当前配置,只忽略瞬时副本 =====
sdkconfig.old
sdkconfig.bak

